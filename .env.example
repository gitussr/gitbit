# Client-side — inlined into the browser bundle by Vite, so public by design.
VITE_ONESIGNAL_APP_ID=

# Server-only, used by the daily-push cron function (api/daily-push.ts).
# Set these in the Vercel project's environment variables. Never give them a
# VITE_ prefix: that would inline the REST key into the client bundle.
#   ONESIGNAL_APP_ID       same value as VITE_ONESIGNAL_APP_ID (optional —
#                          falls back to it if unset)
#   ONESIGNAL_REST_API_KEY OneSignal Dashboard > Settings > Keys & IDs
#   CRON_SECRET            any long random string; Vercel sends it as
#                          `Authorization: Bearer <secret>` on cron runs, and
#                          the route refuses to send without it
#   ONESIGNAL_SEGMENT      optional; must match OneSignal > Audience >
#                          Segments exactly. Defaults to "Total
#                          Subscriptions" (newer apps); older apps call it
#                          "Subscribed Users"
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
CRON_SECRET=
ONESIGNAL_SEGMENT=
